{
  "manifest_version": 3,
  "name": "Simple English Translator (Gemma 2B)",
  "version": "1.0.0",
  "description": "Translates webpage HTML/text into Simple English using a local Gemma 2B model via Ollama or custom local server.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "css": ["content/content_style.css"]
    }
  ],
  "options_page": "options/options.html",
  "icons": {
    "128": "icons/icon.svg"
  }
}
